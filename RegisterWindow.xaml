<Window x:Class="StarkFNLauncher.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stark FN — Register" Width="460" Height="600"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Border CornerRadius="10" BorderThickness="1" Background="#1A1D23" BorderBrush="#252830">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="50" ShadowDepth="0" Opacity="0.9"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#13151A" CornerRadius="10,10,0,0"
                    MouseLeftButtonDown="TitleBar_Drag">
                <DockPanel Margin="14,0">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="16" Height="16" Margin="0,0,8,0">
                            <Canvas Width="40" Height="44">
                                <Polygon Points="20,0 40,44 32,44 20,14 8,44 0,44" Fill="White"/>
                                <Polygon Points="20,20 28,38 12,38" Fill="#13151A"/>
                                <Rectangle Canvas.Left="10" Canvas.Top="28" Width="20" Height="4" Fill="White"/>
                                <Polygon Points="20,20 28,38 12,38" Fill="#13151A"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Stark FN" FontFamily="Segoe UI" FontSize="13"
                                   FontWeight="SemiBold" Foreground="#E8E9EC" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Width="36" Height="36" Cursor="Hand"
                            HorizontalAlignment="Right" Click="Close_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" CornerRadius="5" Background="Transparent">
                                    <TextBlock Text="✕" FontFamily="Segoe UI" FontSize="12"
                                               Foreground="#5C6070" HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#3A0C0C"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </DockPanel>
            </Border>

            <StackPanel Grid.Row="1" Margin="44,24,44,32">
                <TextBlock Text="Create Account" FontFamily="Segoe UI" FontSize="22"
                           FontWeight="SemiBold" Foreground="White"
                           HorizontalAlignment="Center" Margin="0,0,0,5"/>
                <TextBlock Text="Join the Stark FN private server"
                           FontFamily="Segoe UI" FontSize="11" Foreground="#4A5060"
                           HorizontalAlignment="Center" Margin="0,0,0,24"/>

                <Border x:Name="StatusBorder" Background="#0D0F14" BorderBrush="#252830"
                        BorderThickness="1" CornerRadius="7" Padding="12,8"
                        Margin="0,0,0,16" Visibility="Collapsed">
                    <TextBlock x:Name="StatusMsg" FontFamily="Segoe UI" FontSize="11"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                </Border>
                <Grid Margin="0,0,0,12"/>
                <Grid Margin="0,0,0,12"/>
                <Grid Margin="0,0,0,12"/>
                <Grid Margin="0,0,0,24"/>
                <Button x:Name="RegBtn" Height="76" Cursor="Hand" Click="Register_Click" Width="190" Background="#FFC31010" BorderBrush="#FF863C3C">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="bd" CornerRadius="7" BorderThickness="1" BorderBrush="#FF2B2B2B">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#4E5AF2" Offset="0"/>
                                        <GradientStop Color="#FF7F0632" Offset="1"/>
                                        <GradientStop Color="#FF170707" Offset="0"/>
                                        <GradientStop Color="#FF170707" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <TextBlock x:Name="lbl" Text="JOIN DISCORD"
                                           FontFamily="Segoe UI" FontSize="12" FontWeight="Bold"
                                           Foreground="White" HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                                    <Setter TargetName="lbl" Property="Text" Value="CREATING..."/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                    <TextBlock Text="Already have an account?  "
                               FontFamily="Segoe UI" FontSize="11" Foreground="#2E3240"/>
                    <TextBlock Text="Sign in" FontFamily="Segoe UI" FontSize="11"
                               Foreground="#7289DA" Cursor="Hand"
                               MouseLeftButtonDown="Back_Click">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="TextDecorations" Value="Underline"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
