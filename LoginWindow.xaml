<Window x:Class="StarkFNLauncher.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stark FN" Width="440" Height="580"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Border CornerRadius="12" BorderBrush="#33FFFFFF" BorderThickness="1">
        <Border.Background>
            <SolidColorBrush Color="#0D0D14"/>
        </Border.Background>
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="60" ShadowDepth="0" Opacity="0.9"/>
        </Border.Effect>
        <Grid Margin="9,0,-9,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="28"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Titlebar -->
            <Grid Grid.Row="0" MouseLeftButtonDown="TitleBar_Drag">
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Width="28" Height="28" Click="Min_Click" Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <TextBlock Text="─" FontFamily="Segoe UI" FontSize="11" Foreground="#4B5563" Margin="0,5,0,0"/>
                    </Button>
                    <Button Width="28" Height="28" Click="Close_Click" Background="Transparent" BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="Transparent" Width="28" Height="28" CornerRadius="4">
                                    <TextBlock Text="✕" FontFamily="Segoe UI" FontSize="11" Foreground="#4B5563"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#7F1D1D"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Body -->
            <StackPanel Grid.Row="1" Margin="44,10,44,36">
                <!-- Logo -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,28">
                    <TextBlock Text="✦" FontSize="44" Foreground="White"
                               HorizontalAlignment="Center" Margin="0,0,0,14">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="White" BlurRadius="16" ShadowDepth="0" Opacity="0.7"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Text="Welcome to Stark FN" FontFamily="Segoe UI" FontSize="18"
                               FontWeight="Bold" Foreground="White"
                               HorizontalAlignment="Center" Margin="0,0,0,4"/>
                    <TextBlock Text="Chapter 2  ·  Season 4  ·  14.60"
                               FontFamily="Segoe UI" FontSize="11"
                               Foreground="#374151" HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Status -->
                <Border x:Name="StatusBorder" Background="#06FFFFFF" BorderBrush="#1AFFFFFF"
                        BorderThickness="1" CornerRadius="8" Padding="14,9"
                        Margin="0,0,0,14" Visibility="Collapsed">
                    <TextBlock x:Name="StatusMsg" FontFamily="Segoe UI" FontSize="12"
                               TextAlignment="Center" TextWrapping="Wrap" Foreground="#A5B4FC"/>
                </Border>

                <!-- Username -->
                <Grid Margin="0,0,0,12"/>

                <!-- Password -->
                <Grid Margin="0,0,0,20"/>

                <!-- Sign In -->

                <!-- Discord -->
                <Button x:Name="DiscordBtn" Height="79" Cursor="Hand" Click="Discord_Click" Width="239">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd" CornerRadius="8" Background="#1A5865F2"
                                    BorderBrush="#335865F2" BorderThickness="1">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Viewbox Width="16" Height="16" Margin="0,0,10,0">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="#7289DA" Data="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057c.002.022.015.043.032.054a19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03z"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock x:Name="dlbl" Text="Continue with Discord"
                                               FontFamily="Segoe UI" FontSize="13"
                                               FontWeight="SemiBold" Foreground="#7289DA"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="#265865F2"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.5"/>
                                    <Setter TargetName="dlbl" Property="Text" Value="Opening Discord..."/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Register link -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                    <TextBlock Text="Don't have an account? " FontFamily="Segoe UI"
                               FontSize="12" Foreground="#374151"/>
                    <TextBlock Text="join discord" FontFamily="Segoe UI" FontSize="12"
                               Foreground="#9CA3AF" Cursor="Hand"
                               MouseLeftButtonDown="Register_Click">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="TextDecorations" Value="Underline"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
