import tkinter as tk
from tkinter import messagebox
import threading
import time
import random

# ---------------- ARC SERVICE ----------------
class ARCService:
    def __init__(self, callback):
        self.running = False
        self.callback = callback

    def start(self):
        if self.running:
            return
        self.running = True
        threading.Thread(target=self.run, daemon=True).start()

    def run(self):
        self.callback("ARC: Initializing...")
        time.sleep(1)

        while self.running:
            self.callback("ARC: Stable • Sync OK")
            time.sleep(2)

    def stop(self):
        self.running = False
        self.callback("ARC: Offline")


# ---------------- AUTO UPDATER ----------------
class AutoUpdater:
    def __init__(self, callback):
        self.callback = callback

    def check_update(self):
        self.callback("Updater: Checking files...")
        time.sleep(1)

        # simulated update check
        if random.choice([True, False]):
            self.callback("Updater: Update found (15MB)")
            self.download()
        else:
            self.callback("Updater: Fully up to date")

    def download(self):
        for i in range(1, 6):
            self.callback(f"Downloading... {i * 20}%")
            time.sleep(0.5)
        self.callback("Updater: Install complete")


# ---------------- MAIN LAUNCHER ----------------
class Launcher:
    def __init__(self, root):
        self.root = root
        self.root.title("Launcher")
        self.root.geometry("700x420")
        self.root.configure(bg="#0f0f0f")

        self.arc = ARCService(self.set_status)
        self.updater = AutoUpdater(self.set_status)

        self.login_screen()

    # ---------------- LOGIN ----------------
    def login_screen(self):
        self.clear()

        frame = tk.Frame(self.root, bg="#0f0f0f")
        frame.pack(expand=True)

        tk.Label(frame, text="LOGIN", fg="white", bg="#0f0f0f", font=("Arial", 20, "bold")).pack(pady=10)

        self.user_entry = tk.Entry(frame)
        self.user_entry.pack(pady=5)
        self.pass_entry = tk.Entry(frame, show="*")
        self.pass_entry.pack(pady=5)

        tk.Button(frame, text="Login", command=self.login).pack(pady=10)

    def login(self):
        if self.user_entry.get() and self.pass_entry.get():
            self.main_ui()
        else:
            messagebox.showerror("Error", "Enter credentials")

    # ---------------- MAIN UI ----------------
    def main_ui(self):
        self.clear()

        # sidebar
        sidebar = tk.Frame(self.root, bg="#1a1a1a", width=150)
        sidebar.pack(side="left", fill="y")

        tk.Button(sidebar, text="Play", command=self.play).pack(fill="x")
        tk.Button(sidebar, text="Skins", command=self.skins).pack(fill="x")
        tk.Button(sidebar, text="ARC", command=self.arc_panel).pack(fill="x")
        tk.Button(sidebar, text="Settings", command=self.settings).pack(fill="x")

        # main panel
        self.panel = tk.Frame(self.root, bg="#0f0f0f")
        self.panel.pack(expand=True, fill="both")

        self.status = tk.Label(self.panel, text="Ready", fg="lime", bg="#0f0f0f")
        self.status.pack(pady=10)

        tk.Button(self.panel, text="Run Auto-Updater", command=self.run_update).pack(pady=5)
        tk.Button(self.panel, text="Start ARC", command=self.arc.start).pack(pady=5)
        tk.Button(self.panel, text="Stop ARC", command=self.arc.stop).pack(pady=5)

    # ---------------- FEATURES ----------------
    def play(self):
        self.loading_screen("Launching Play...")

    def skins(self):
        self.set_status("Skin menu opened")

    def arc_panel(self):
        self.set_status("ARC panel active")

    def settings(self):
        self.set_status("Settings opened")

    def run_update(self):
        threading.Thread(target=self.updater.check_update, daemon=True).start()

    # ---------------- LOADING SCREEN ----------------
    def loading_screen(self, text):
        self.clear()

        frame = tk.Frame(self.root, bg="#000")
        frame.pack(expand=True, fill="both")

        label = tk.Label(frame, text=text, fg="white", bg="#000", font=("Arial", 18))
        label.pack(pady=50)

        bar = tk.Label(frame, text="Loading...", fg="lime", bg="#000")
        bar.pack()

        def animate():
            for i in range(6):
                bar.config(text="Loading" + "." * i)
                time.sleep(0.4)
            self.main_ui()

        threading.Thread(target=animate, daemon=True).start()

    # ---------------- UTIL ----------------
    def set_status(self, text):
        if hasattr(self, "status"):
            self.status.config(text=text)

    def clear(self):
        for w in self.root.winfo_children():
            w.destroy()


if __name__ == "__main__":
    root = tk.Tk()
    Launcher(root)
    root.mainloop()
