<Window x:Class="StarkFNLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Stark FN" Width="1220" Height="740"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="GlassBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="7" Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1" Padding="14,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.35"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="8" Padding="22,10">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#6366F1" Offset="0"/>
                                    <GradientStop Color="#8B5CF6" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#6366F1" BlurRadius="16" ShadowDepth="0" Opacity="0.45"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SideBtn" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#10FFFFFF"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="#18FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SideBtnActive" TargetType="Button" BasedOn="{StaticResource SideBtn}">
            <Setter Property="Background" Value="#1A6366F1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" CornerRadius="10" Background="#1A6366F1" BorderBrush="#336366F1" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect Color="#6366F1" BlurRadius="14" ShadowDepth="0" Opacity="0.25"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border x:Name="RootBorder" CornerRadius="14" BorderBrush="#20FFFFFF" BorderThickness="1">
            <Border.Background>
                <SolidColorBrush Color="#09090F"/>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="90" ShadowDepth="0" Opacity="1"/>
            </Border.Effect>
            <Grid ClipToBounds="True">

                <Canvas IsHitTestVisible="False">
                    <Ellipse Canvas.Left="-100" Canvas.Top="-100" Width="500" Height="500" Opacity="0.06">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#6366F1" Offset="0"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Canvas.Right="-150" Canvas.Bottom="-150" Width="600" Height="600" Opacity="0.04">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#8B5CF6" Offset="0"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                </Canvas>
                <Canvas x:Name="ParticleCanvas" IsHitTestVisible="False"/>

                <!-- LOADING -->
                <Grid x:Name="LoadingScreen">
                  <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#04040C" Offset="0"/><GradientStop Color="#09091E" Offset="1"/></LinearGradientBrush></Grid.Background>

                  <!-- Ambient rings -->
                  <Canvas IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse Canvas.Left="-300" Canvas.Top="-300" Width="600" Height="600" Stroke="#06FFFFFF" StrokeThickness="1" Opacity="0.5"/>
                    <Ellipse Canvas.Left="-220" Canvas.Top="-220" Width="440" Height="440" Stroke="#08FFFFFF" StrokeThickness="1"/>
                    <Ellipse Canvas.Left="-140" Canvas.Top="-140" Width="280" Height="280" Stroke="#0A6366F1" StrokeThickness="1">
                      <Ellipse.Effect><DropShadowEffect Color="#6366F1" BlurRadius="12" ShadowDepth="0" Opacity="0.4"/></Ellipse.Effect>
                    </Ellipse>
                  </Canvas>

                  <!-- Center content -->
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                    <!-- Logo orb -->
                    <Grid Width="100" Height="100" HorizontalAlignment="Center" Margin="0,0,0,32">
                      <Ellipse Width="100" Height="100">
                        <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#1A1870" Offset="0"/><GradientStop Color="#06060E" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
                      </Ellipse>
                      <Ellipse Width="100" Height="100" Stroke="#1A6366F1" StrokeThickness="1"/>
                      <Ellipse Width="70" Height="70" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#2D2A90" Offset="0"/><GradientStop Color="#0D0C28" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
                      </Ellipse>
                      <TextBlock Text="✦" FontSize="36" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe UI">
                        <TextBlock.Effect><DropShadowEffect Color="#6366F1" BlurRadius="28" ShadowDepth="0" Opacity="1"/></TextBlock.Effect>
                      </TextBlock>
                    </Grid>

                    <!-- Title -->
                    <TextBlock Text="STARK FN" FontFamily="Segoe UI" FontSize="38" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,4">
                      <TextBlock.Effect><DropShadowEffect Color="#6366F1" BlurRadius="30" ShadowDepth="0" Opacity="0.55"/></TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Text="FORTNITE PRIVATE SERVER" FontFamily="Segoe UI" FontSize="9" FontWeight="SemiBold" Foreground="#2D3A5A" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="Chapter 2  ·  Season 4  ·  Build 14.60" FontFamily="Segoe UI" FontSize="11" Foreground="#1A2340" HorizontalAlignment="Center" Margin="0,0,0,52"/>

                    <!-- Progress bar -->
                    <Border Width="320" HorizontalAlignment="Center" Margin="0,0,0,16">
                      <Grid Height="4">
                        <Border Height="4" Background="#0AFFFFFF" CornerRadius="2"/>
                        <Border Height="4" HorizontalAlignment="Left" CornerRadius="2">
                          <Border x:Name="LoadBar" Width="0" Height="4" CornerRadius="2" HorizontalAlignment="Left">
                            <Border.Background>
                              <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#6366F1" Offset="0"/>
                                <GradientStop Color="#A78BFA" Offset="0.5"/>
                                <GradientStop Color="#EC4899" Offset="1"/>
                              </LinearGradientBrush>
                            </Border.Background>
                            <Border.Effect><DropShadowEffect Color="#8B5CF6" BlurRadius="12" ShadowDepth="0" Opacity="0.9"/></Border.Effect>
                          </Border>
                        </Border>
                        <Border x:Name="LoadDot" Width="10" Height="10" Background="White" CornerRadius="5" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="-5,0,0,0">
                          <Border.Effect><DropShadowEffect Color="#A78BFA" BlurRadius="10" ShadowDepth="0" Opacity="1"/></Border.Effect>
                          <Border.RenderTransform><TranslateTransform x:Name="DotTranslate" X="0"/></Border.RenderTransform>
                        </Border>
                      </Grid>
                    </Border>

                    <TextBlock x:Name="LoadMsg" Text="Starting..." FontFamily="Segoe UI" FontSize="12" Foreground="#2D3A5A" HorizontalAlignment="Center"/>
                  </StackPanel>

                  <!-- Version watermark -->
                  <TextBlock Text="v1.0" FontFamily="Segoe UI" FontSize="10" Foreground="#0D1020"
                             HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,14"/>
                </Grid>

                <!-- UPDATE MODAL -->
                <Grid x:Name="UpdateModal" Visibility="Collapsed">
                  <Grid.Background><SolidColorBrush Color="#000000" Opacity="0.85"/></Grid.Background>
                  <Border Width="480" CornerRadius="16" BorderBrush="#22FFFFFF" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#0D0D22" Offset="0"/><GradientStop Color="#09090F" Offset="1"/></LinearGradientBrush></Border.Background>
                    <Border.Effect><DropShadowEffect Color="Black" BlurRadius="60" ShadowDepth="0" Opacity="0.9"/></Border.Effect>
                    <StackPanel Margin="36,32">
                      <!-- Icon -->
                      <Grid Width="56" Height="56" HorizontalAlignment="Center" Margin="0,0,0,20">
                        <Ellipse Width="56" Height="56"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#1A1870" Offset="0"/><GradientStop Color="#09090F" Offset="1"/></RadialGradientBrush></Ellipse.Fill></Ellipse>
                        <TextBlock Text="↑" FontSize="24" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe UI" FontWeight="Bold">
                          <TextBlock.Effect><DropShadowEffect Color="#6366F1" BlurRadius="16" ShadowDepth="0" Opacity="0.8"/></TextBlock.Effect>
                        </TextBlock>
                      </Grid>
                      <TextBlock Text="Update Available" FontFamily="Segoe UI" FontSize="20" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                      <TextBlock x:Name="UpdateVersionTxt" Text="" FontFamily="Segoe UI" FontSize="13" Foreground="#A5B4FC" HorizontalAlignment="Center" Margin="0,0,0,14"/>
                      <TextBlock x:Name="UpdateNotesTxt" Text="" FontFamily="Segoe UI" FontSize="12" Foreground="#4B5563" HorizontalAlignment="Center" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,28"/>
                      <!-- Progress bar for download -->
                      <Border x:Name="UpdateProgressWrap" Height="4" CornerRadius="2" Background="#0AFFFFFF" Margin="0,0,0,8" Visibility="Collapsed">
                        <Border x:Name="UpdateProgressBar" Width="0" Height="4" CornerRadius="2" HorizontalAlignment="Left">
                          <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#6366F1" Offset="0"/><GradientStop Color="#8B5CF6" Offset="1"/></LinearGradientBrush></Border.Background>
                        </Border>
                      </Border>
                      <TextBlock x:Name="UpdateProgressTxt" Text="" FontFamily="Segoe UI" FontSize="10" Foreground="#374151" HorizontalAlignment="Center" Margin="0,0,0,24"/>
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource PrimaryBtn}" Margin="0,0,10,0" Click="DoUpdate_Click" x:Name="UpdateBtn">
                          <TextBlock Text="Download &amp; Update" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                        </Button>
                        <Button Style="{StaticResource GlassBtn}" Click="SkipUpdate_Click">
                          <TextBlock Text="Skip for Now" FontFamily="Segoe UI" FontSize="12" Foreground="#9CA3AF"/>
                        </Button>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </Grid>

                <!-- BUILD CHECK MODAL -->
                <Grid x:Name="IntegrityModal" Visibility="Collapsed">
                  <Grid.Background><SolidColorBrush Color="#000000" Opacity="0.85"/></Grid.Background>
                  <Border Width="500" CornerRadius="16" BorderBrush="#22FFFFFF" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#0D0D22" Offset="0"/><GradientStop Color="#09090F" Offset="1"/></LinearGradientBrush></Border.Background>
                    <Border.Effect><DropShadowEffect Color="Black" BlurRadius="60" ShadowDepth="0" Opacity="0.9"/></Border.Effect>
                    <StackPanel Margin="36,32">
                      <Grid Width="56" Height="56" HorizontalAlignment="Center" Margin="0,0,0,20">
                        <Ellipse Width="56" Height="56"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#1A1870" Offset="0"/><GradientStop Color="#09090F" Offset="1"/></RadialGradientBrush></Ellipse.Fill></Ellipse>
                        <TextBlock Text="🔍" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Grid>
                      <TextBlock x:Name="IntegrityTitle" Text="Checking Build Integrity..." FontFamily="Segoe UI" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                      <TextBlock x:Name="IntegritySubTxt" Text="Scanning your Fortnite 14.60 build files..." FontFamily="Segoe UI" FontSize="12" Foreground="#4B5563" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                      <Border Height="4" CornerRadius="2" Background="#0AFFFFFF" Margin="0,0,0,8">
                        <Border x:Name="IntegrityBar" Width="0" Height="4" CornerRadius="2" HorizontalAlignment="Left">
                          <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#6366F1" Offset="0"/><GradientStop Color="#8B5CF6" Offset="1"/></LinearGradientBrush></Border.Background>
                        </Border>
                      </Border>
                      <TextBlock x:Name="IntegrityPct" Text="0%" FontFamily="Segoe UI" FontSize="10" Foreground="#374151" HorizontalAlignment="Center" Margin="0,0,0,24"/>
                      <StackPanel x:Name="IntegrityResult" Visibility="Collapsed" Margin="0,0,0,20">
                        <Border CornerRadius="8" Padding="14,12" BorderBrush="#0EFFFFFF" BorderThickness="1" Margin="0,0,0,10">
                          <Border.Background><SolidColorBrush Color="#0C0D1A" Opacity="0.8"/></Border.Background>
                          <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel HorizontalAlignment="Center">
                              <TextBlock x:Name="IntChecked" Text="0" FontFamily="Segoe UI" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                              <TextBlock Text="Checked" FontFamily="Segoe UI" FontSize="10" Foreground="#374151" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                              <TextBlock x:Name="IntMissing" Text="0" FontFamily="Segoe UI" FontSize="22" FontWeight="Bold" Foreground="#EF4444" HorizontalAlignment="Center"/>
                              <TextBlock Text="Missing" FontFamily="Segoe UI" FontSize="10" Foreground="#374151" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                              <TextBlock x:Name="IntCorrupt" Text="0" FontFamily="Segoe UI" FontSize="22" FontWeight="Bold" Foreground="#F59E0B" HorizontalAlignment="Center"/>
                              <TextBlock Text="Issues" FontFamily="Segoe UI" FontSize="10" Foreground="#374151" HorizontalAlignment="Center"/>
                            </StackPanel>
                          </Grid>
                        </Border>
                        <TextBlock x:Name="IntStatusTxt" Text="" FontFamily="Segoe UI" FontSize="12" HorizontalAlignment="Center" TextWrapping="Wrap"/>
                      </StackPanel>
                      <Button Style="{StaticResource GlassBtn}" HorizontalAlignment="Center" Click="CloseIntegrity_Click" x:Name="IntegrityCloseBtn" Visibility="Collapsed">
                        <TextBlock Text="Close" FontFamily="Segoe UI" FontSize="12" Foreground="#9CA3AF"/>
                      </Button>
                    </StackPanel>
                  </Border>
                </Grid>


                <!-- APP -->
                <Grid x:Name="AppShell" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- TOP BAR -->
                    <Border Grid.Row="0" BorderBrush="#0EFFFFFF" BorderThickness="0,0,0,1">
                        <Border.Background>
                            <SolidColorBrush Color="#060610" Opacity="0.9"/>
                        </Border.Background>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                                <Grid Width="28" Height="28" Margin="0,0,10,0">
                                    <Ellipse Fill="#1A1A40"/>
                                    <TextBlock Text="✦" FontSize="14" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Effect>
                                            <DropShadowEffect Color="#6366F1" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                                        </TextBlock.Effect>
                                    </TextBlock>
                                </Grid>
                                <TextBlock Text="Stark FN" FontFamily="Segoe UI" FontSize="14" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" Margin="0,0,20,0"/>
                                <Border Width="1" Height="18" Background="#10FFFFFF" Margin="0,0,20,0"/>

                                <!-- HOME -->
                                <Button x:Name="BtnHome" Cursor="Hand" Click="Nav_Click" Tag="Home" Width="36" Height="36" Margin="2,0" ToolTip="Home">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" CornerRadius="9" Background="#1A6366F1" BorderBrush="#336366F1" BorderThickness="1">
                                                <Viewbox Width="16" Height="16">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Fill="White" Data="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/>
                                                    </Canvas>
                                                </Viewbox>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#226366F1"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- LIBRARY -->
                                <Button x:Name="BtnLibrary" Cursor="Hand" Click="Nav_Click" Tag="Library" Width="36" Height="36" Margin="2,0" ToolTip="Library">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" CornerRadius="9" Background="#0AFFFFFF" BorderBrush="#12FFFFFF" BorderThickness="1">
                                                <Viewbox Width="16" Height="16">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Fill="#6B7280" Data="M3 3h8v8H3zm0 10h8v8H3zm10-10h8v8h-8zm0 10h8v8h-8z"/>
                                                    </Canvas>
                                                </Viewbox>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#14FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- NEWS -->
                                <Button x:Name="BtnNews" Cursor="Hand" Click="Nav_Click" Tag="News" Width="36" Height="36" Margin="2,0" ToolTip="News">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" CornerRadius="9" Background="#0AFFFFFF" BorderBrush="#12FFFFFF" BorderThickness="1">
                                                <Grid>
                                                    <Viewbox Width="16" Height="16">
                                                        <Canvas Width="24" Height="24">
                                                            <Path Fill="#6B7280" Data="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 14H4V8l8 5 8-5v10zm-8-7L4 6h16l-8 5z"/>
                                                        </Canvas>
                                                    </Viewbox>
                                                    <Ellipse Width="7" Height="7" Fill="#6366F1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0">
                                                        <Ellipse.Effect>
                                                            <DropShadowEffect Color="#6366F1" BlurRadius="4" ShadowDepth="0" Opacity="0.8"/>
                                                        </Ellipse.Effect>
                                                    </Ellipse>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="#14FFFFFF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- STATS -->
                                <Button x:Name="BtnStats" Cursor="Hand" Click="Nav_Click" Tag="Stats" Width="36" Height="36" Margin="2,0" ToolTip="Stats">
                  <Button.Template>
                    <ControlTemplate TargetType="Button">
                      <Border x:Name="bd" CornerRadius="9" Background="#0AFFFFFF" BorderBrush="#12FFFFFF" BorderThickness="1">
                        <Viewbox Width="16" Height="16">
                          <Canvas Width="24" Height="24">
                            <Path Fill="#6B7280" Data="M5 9.2h3V19H5zM10.6 5h2.8v14h-2.8zm5.6 8H19v6h-2.8z"/>
                          </Canvas>
                        </Viewbox>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#14FFFFFF"/></Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Button.Template>
                </Button>

                <!-- FRIENDS (NEW) -->
                <Button x:Name="BtnFriends" Cursor="Hand" Click="Nav_Click" Tag="Friends" Width="36" Height="36" Margin="2,0" ToolTip="Friends">
                  <Button.Template>
                    <ControlTemplate TargetType="Button">
                      <Border x:Name="bd" CornerRadius="9" Background="#0AFFFFFF" BorderBrush="#12FFFFFF" BorderThickness="1">
                        <Grid>
                          <Viewbox Width="16" Height="16">
                            <Canvas Width="24" Height="24">
                              <Path Fill="#6B7280" Data="M16 11c1.66 0 2.99-1.34 2.99-3S17.66 5 16 5c-1.66 0-3 1.34-3 3s1.34 3 3 3zm-8 0c1.66 0 2.99-1.34 2.99-3S9.66 5 8 5C6.34 5 5 6.34 5 8s1.34 3 3 3zm0 2c-2.33 0-7 1.17-7 3.5V19h14v-2.5c0-2.33-4.67-3.5-7-3.5zm8 0c-.29 0-.62.02-.97.05 1.16.84 1.97 1.97 1.97 3.45V19h6v-2.5c0-2.33-4.67-3.5-7-3.5z"/>
                            </Canvas>
                          </Viewbox>
                          <Ellipse x:Name="FriendsBadge" Width="8" Height="8" Fill="#10B981"
                                   HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0"
                                   Visibility="Collapsed">
                            <Ellipse.Effect><DropShadowEffect Color="#10B981" BlurRadius="4" ShadowDepth="0" Opacity="0.9"/></Ellipse.Effect>
                          </Ellipse>
                        </Grid>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#14FFFFFF"/></Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Button.Template>
                </Button>

                                <!-- SETTINGS -->
                                <Button x:Name="BtnSettings" Cursor="Hand" Click="Nav_Click" Tag="Settings" Width="36" Height="36" Margin="2,0" ToolTip="Settings">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" CornerRadius="9" Background="#0AFFFFFF" BorderBrush="#12FFFFFF" BorderThickness="1">
                                                <Viewbox Width="16" Height="16">
                                                    <Canvas Width="24" Height="24">
