                                                    <Border x:Name="ToggleEORThumb" Width="18" Height="18" CornerRadius="9" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0" Background="#4B5563">
                                                        <Border.RenderTransform>
                                                            <TranslateTransform x:Name="EORThumbTx" X="0"/>
                                                        </Border.RenderTransform>
                                                    </Border>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <Border Padding="18,14" BorderBrush="#08FFFFFF" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Disable Texture Streaming" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                                    <TextBlock Text="Reduces VRAM usage, recommended for lower-end PCs" FontFamily="Segoe UI" FontSize="10" Foreground="#4B5563" Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <Border x:Name="ToggleTexture" Grid.Column="1" Width="44" Height="24" CornerRadius="12" Cursor="Hand" MouseLeftButtonDown="Toggle_Texture" VerticalAlignment="Center" Background="#1A3A22">
                                                    <Border x:Name="ToggleTextureThumb" Width="18" Height="18" CornerRadius="9" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0" Background="#10B981">
                                                        <Border.RenderTransform>
                                                            <TranslateTransform x:Name="TextureThumbTx" X="20"/>
                                                        </Border.RenderTransform>
                                                    </Border>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <Border Padding="18,14" BorderBrush="#08FFFFFF" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Force DirectX 11" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                                    <TextBlock Text="Launch with -dx11 flag for better compatibility" FontFamily="Segoe UI" FontSize="10" Foreground="#4B5563" Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <Border x:Name="ToggleDX11" Grid.Column="1" Width="44" Height="24" CornerRadius="12" Cursor="Hand" MouseLeftButtonDown="Toggle_DX11" VerticalAlignment="Center" Background="#1A3A22">
                                                    <Border x:Name="ToggleDX11Thumb" Width="18" Height="18" CornerRadius="9" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0" Background="#10B981">
                                                        <Border.RenderTransform>
                                                            <TranslateTransform x:Name="DX11ThumbTx" X="20"/>
                                                        </Border.RenderTransform>
                                                    </Border>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <Border Padding="18,14" BorderBrush="#08FFFFFF" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Skip Splash Screen" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                                    <TextBlock Text="Skip the Epic Games splash screen on launch" FontFamily="Segoe UI" FontSize="10" Foreground="#4B5563" Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <Border x:Name="ToggleSplash" Grid.Column="1" Width="44" Height="24" CornerRadius="12" Cursor="Hand" MouseLeftButtonDown="Toggle_Splash" VerticalAlignment="Center" Background="#1A3A22">
                                                    <Border x:Name="ToggleSplashThumb" Width="18" Height="18" CornerRadius="9" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0" Background="#10B981">
                                                        <Border.RenderTransform>
                                                            <TranslateTransform x:Name="SplashThumbTx" X="20"/>
                                                        </Border.RenderTransform>
                                                    </Border>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <Border Padding="18,14">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Auto Patch Hosts on Launch" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                                    <TextBlock Text="Automatically patch hosts file when you click Play" FontFamily="Segoe UI" FontSize="10" Foreground="#4B5563" Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <Border x:Name="ToggleAutoPatch" Grid.Column="1" Width="44" Height="24" CornerRadius="12" Cursor="Hand" MouseLeftButtonDown="Toggle_AutoPatch" VerticalAlignment="Center" Background="#1A3A22">
                                                    <Border x:Name="ToggleAutoPatchThumb" Width="18" Height="18" CornerRadius="9" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0" Background="#10B981">
                                                        <Border.RenderTransform>
                                                            <TranslateTransform x:Name="AutoPatchThumbTx" X="20"/>
                                                        </Border.RenderTransform>
                                                    </Border>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="LAUNCHER SETTINGS" FontFamily="Segoe UI" FontSize="8" FontWeight="Bold" Foreground="#374151" Margin="0,0,0,8"/>
                                <Border CornerRadius="12" Padding="0" Margin="0,0,0,20" BorderBrush="#0EFFFFFF" BorderThickness="1">
                                    <Border.Background>
                                        <SolidColorBrush Color="#0C0D1A" Opacity="0.7"/>
                                    </Border.Background>
                                    <StackPanel>
                                        <Border Padding="18,14" BorderBrush="#08FFFFFF" BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Discord Rich Presence" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                                    <TextBlock Text="Show Stark FN activity status in Discord" FontFamily="Segoe UI" FontSize="10" Foreground="#4B5563" Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <Border x:Name="ToggleRPC" Grid.Column="1" Width="44" Height="24" CornerRadius="12" Cursor="Hand" MouseLeftButtonDown="Toggle_RPC" VerticalAlignment="Center" Background="#1A3A22">
                                                    <Border x:Name="ToggleRPCThumb" Width="18" Height="18" CornerRadius="9" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0" Background="#10B981">
                                                        <Border.RenderTransform>
                                                            <TranslateTransform x:Name="RPCThumbTx" X="20"/>
                                                        </Border.RenderTransform>
                                                    </Border>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <Border Padding="18,14">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Minimize to Tray on Close" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                                    <TextBlock Text="Keep launcher running in the system tray" FontFamily="Segoe UI" FontSize="10" Foreground="#4B5563" Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <Border x:Name="ToggleTray" Grid.Column="1" Width="44" Height="24" CornerRadius="12" Cursor="Hand" MouseLeftButtonDown="Toggle_Tray" VerticalAlignment="Center" Background="#1E2030">
                                                    <Border x:Name="ToggleTrayThumb" Width="18" Height="18" CornerRadius="9" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0" Background="#4B5563">
                                                        <Border.RenderTransform>
                                                            <TranslateTransform x:Name="TrayThumbTx" X="0"/>
                                                        </Border.RenderTransform>
                                                    </Border>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="HOSTS FILE" FontFamily="Segoe UI" FontSize="8" FontWeight="Bold" Foreground="#374151" Margin="0,0,0,8"/>
                                <Border CornerRadius="12" Padding="20" Margin="0,0,0,20" BorderBrush="#0EFFFFFF" BorderThickness="1">
                                    <Border.Background>
                                        <SolidColorBrush Color="#0C0D1A" Opacity="0.7"/>
                                    </Border.Background>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Grid Width="10" Height="10" Margin="0,0,9,0">
                                                <Ellipse x:Name="SetPatchDotOuter" Fill="#30EF4444" Opacity="0.5"/>
                                                <Ellipse x:Name="SetPatchDot" Width="6" Height="6" Fill="#EF4444" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Grid>
                                            <TextBlock x:Name="SetPatchTxt" Text="Not Patched" FontFamily="Segoe UI" FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                        </StackPanel>
                                        <TextBlock Text="Redirects Epic servers to Stark FN so the game connects to your backend." FontFamily="Segoe UI" FontSize="10" Foreground="#374151" TextWrapping="Wrap" Margin="0,0,0,16"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource PrimaryBtn}" Margin="0,0,10,0" Click="PatchHosts_Click">
                                                <TextBlock Text="Patch Hosts" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                                            </Button>
                                            <Button Style="{StaticResource GlassBtn}" Click="RestoreHosts_Click">
                                                <TextBlock Text="Restore" FontFamily="Segoe UI" FontSize="12" Foreground="#9CA3AF"/>
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="Stark FN Launcher v1.0  ·  Chapter 2 Season 4  ·  14.60" FontFamily="Segoe UI" FontSize="9" Foreground="#111318" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                            </StackPanel>
                        </ScrollViewer>

                    </Grid>

                    <!-- TOAST -->
                    <Border x:Name="ToastBar" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,18" Visibility="Collapsed" CornerRadius="10" Padding="14,10" BorderBrush="#14FFFFFF" BorderThickness="1" MinWidth="260" MaxWidth="400">
                        <Border.Background>
                            <SolidColorBrush Color="#0D0E1A" Opacity="0.97"/>
                        </Border.Background>
                        <Border.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="28" ShadowDepth="0" Opacity="0.8"/>
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ToastIcon" Text="ℹ" FontSize="13" Foreground="#6366F1" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ToastTxt" FontFamily="Segoe UI" FontSize="12" Foreground="#D1D5DB" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Profile popup -->
                <Border x:Name="ProfilePopup" Visibility="Collapsed" Width="190" CornerRadius="10" BorderBrush="#22FFFFFF" BorderThickness="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,52,6,0">
                    <Border.Background>
                        <SolidColorBrush Color="#0F1018" Opacity="0.98"/>
                    </Border.Background>
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="24" ShadowDepth="0" Opacity="0.9"/>
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Margin="12,12,12,10">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="34" Height="34" CornerRadius="8" Background="#6366F1" ClipToBounds="True" Margin="0,0,10,0">
                                    <Image x:Name="PopupAvatarImg" Stretch="UniformToFill"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="PopupUsername" Text="" FontFamily="Segoe UI" FontSize="12" FontWeight="SemiBold" Foreground="White"/>
                                    <TextBlock Text="Stark FN Member" FontFamily="Segoe UI" FontSize="9" Foreground="#374151"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        <Border Height="1" Background="#10FFFFFF"/>
                        <Button Background="Transparent" BorderThickness="0" Cursor="Hand" Click="PopupStats_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="Transparent" Padding="12,10">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="📊" FontSize="12" Margin="0,0,10,0"/>
                                            <TextBlock Text="My Stats" FontFamily="Segoe UI" FontSize="12" Foreground="#9CA3AF"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#08FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Background="Transparent" BorderThickness="0" Cursor="Hand" Click="PopupSettings_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="Transparent" Padding="12,10">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⚙" FontSize="12" Foreground="#374151" Margin="0,0,10,0"/>
                                            <TextBlock Text="Settings" FontFamily="Segoe UI" FontSize="12" Foreground="#9CA3AF"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#08FFFFFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Background="Transparent" BorderThickness="0" Cursor="Hand" Click="Logout_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="Transparent" Padding="12,10" CornerRadius="0,0,10,10">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="⏻" FontSize="12" Foreground="#EF4444" Margin="0,0,10,0"/>
                                            <TextBlock Text="Log out" FontFamily="Segoe UI" FontSize="12" Foreground="#EF4444"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#12EF4444"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>

            </Grid>
        </Border>
    </Grid>
</Window>